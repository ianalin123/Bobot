# Copy to .env (gitignored). Load with: uv run uvicorn bob.server:app --env-file .env --host 127.0.0.1 --port 8766
# Mode: sim (Mac workbench, local Ollama), cloud (OpenAI + ElevenLabs), local (Ollama/Whisper/Piper on the robot)
BOB_MODE=sim
# Hardware: sim (timer-based adapter) or real (Feetech arm/base, ReSpeaker, eyes, camera)
BOB_HARDWARE=sim

# Cloud providers (BOB_MODE=cloud)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
BOB_LLM_MODEL=gpt-4.1-mini
BOB_STT_MODEL=gpt-4o-mini-transcribe
BOB_TTS_MODEL=gpt-4o-mini-tts
BOB_TTS_VOICE=ash
# Live speech engine: openai (voice above) or elevenlabs (a cloned voice; make one with scripts/clone_voice.py)
BOB_TTS_PROVIDER=openai
# Minion voice effects, applied to every TTS path (cloud and local): pitch up in semitones, speed factor
BOB_PITCH_SEMITONES=6
BOB_SPEED=1.15
# Use local Whisper/Piper when the cloud call fails
BOB_LOCAL_FALLBACK=0

# Local providers (BOB_MODE=local or fallback)
BOB_OLLAMA_URL=http://127.0.0.1:11434
BOB_MODEL=qwen3:4b-instruct
BOB_WHISPER_MODEL=base.en
BOB_TTS=auto
BOB_MAC_VOICE=Samantha
# BOB_PIPER_MODEL=/absolute/path/to/en_US-lessac-medium.onnx
# BOB_PIPER_EXECUTABLE=piper

# Devices (BOB_HARDWARE=real)
BOB_SERVO_PORT=/dev/ttyACM0
BOB_EYE_PORTS=/dev/ttyACM1,/dev/ttyACM2
BOB_CAMERA_INDEX=-1
BOB_AUDIO_DEVICE=
BOB_DOA=1
BOB_EMOTION=0
BOB_FACE_THRESHOLD=0.363
BOB_POSES=config/poses.json
BOB_PEOPLE_DIR=people
BOB_MODELS_DIR=models/vision
# assets/phrases is the ElevenLabs cache; assets/phrases-openai is rendered with the live OpenAI Minion voice
BOB_PHRASES_DIR=assets/phrases

# Phone console (/console?token=...). Required when binding to 0.0.0.0.
BOB_CONSOLE_TOKEN=
