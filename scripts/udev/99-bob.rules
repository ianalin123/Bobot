# Bob event robot device permissions.
# Install: sudo cp scripts/udev/99-bob.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
# ReSpeaker XVF3800 USB 4-Mic Array: vendor control transfers for DoA and LEDs (pyusb).
SUBSYSTEM=="usb", ATTR{idVendor}=="2886", ATTR{idProduct}=="001a", MODE="0666"
# Servo bus adapter and the two eye displays (USB CDC serial).
KERNEL=="ttyACM*", MODE="0666"
